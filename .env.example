# ─────────────────────────────────────────────────────────────
# ELORA — environment configuration
# Copy to .env.local. Every variable is optional: without them the
# site runs in "dry-run" mode and logs automation events to the console.
# ─────────────────────────────────────────────────────────────

# Public site URL (used for canonical URLs, sitemap and Open Graph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# n8n base URL for production webhooks, e.g. https://n8n.example.com/webhook
# Each event is POSTed to  {N8N_WEBHOOK_BASE_URL}/elora/{event-path}
N8N_WEBHOOK_BASE_URL=

# Optional per-event overrides (take precedence over the base URL)
N8N_WEBHOOK_CONTACT_SUBMITTED=
N8N_WEBHOOK_NEWSLETTER_SUBSCRIBED=
N8N_WEBHOOK_ORDER_CREATED=
N8N_WEBHOOK_CART_ABANDONED=
N8N_WEBHOOK_REVIEW_SUBMITTED=
N8N_WEBHOOK_SUPPORT_ESCALATED=

# Shared secret used to sign every webhook body (HMAC-SHA256).
# n8n verifies the X-Elora-Signature header with the same secret.
N8N_WEBHOOK_SECRET=
