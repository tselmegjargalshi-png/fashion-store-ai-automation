{
  "name": "ELORA — Customer inquiry triage",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "elora/contact-submitted",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "a1f0c6c2-0001-4a7e-9a10-000000000001",
      "name": "Webhook: contact.submitted",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 300],
      "webhookId": "elora-contact-submitted"
    },
    {
      "parameters": {
        "jsCode": "// Verify the HMAC-SHA256 signature sent by the ELORA storefront.\n// Requires NODE_FUNCTION_ALLOW_BUILTIN=crypto and the secret below to match N8N_WEBHOOK_SECRET on the site.\nconst crypto = require('crypto');\nconst SECRET = 'replace-with-your-shared-secret';\n\nconst item = $input.first().json;\nconst body = item.body;\nconst received = item.headers['x-elora-signature'] || '';\nconst expected = 'sha256=' + crypto.createHmac('sha256', SECRET).update(JSON.stringify(body)).digest('hex');\n\nconst valid = received.length === expected.length && crypto.timingSafeEqual(Buffer.from(received), Buffer.from(expected));\n\nreturn [{ json: { valid, eventId: body.id, inquiry: body.data.inquiry } }];"
      },
      "id": "a1f0c6c2-0002-4a7e-9a10-000000000002",
      "name": "Verify signature",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [240, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
          "conditions": [
            {
              "id": "c0ffee00-0000-4000-8000-000000000001",
              "leftValue": "={{ $json.valid }}",
              "rightValue": true,
              "operator": { "type": "boolean", "operation": "true", "singleValue": true }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "a1f0c6c2-0003-4a7e-9a10-000000000003",
      "name": "Signature valid?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [480, 300]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { \"received\": true, \"eventId\": $json.eventId } }}",
        "options": { "responseCode": 202 }
      },
      "id": "a1f0c6c2-0004-4a7e-9a10-000000000004",
      "name": "Respond 202",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [720, 200]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { \"error\": \"invalid signature\" } }}",
        "options": { "responseCode": 401 }
      },
      "id": "a1f0c6c2-0005-4a7e-9a10-000000000005",
      "name": "Respond 401",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [720, 420]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "anthropic-version", "value": "2023-06-01" },
            { "name": "content-type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ model: 'claude-sonnet-5-5', max_tokens: 800, system: 'You are the customer care lead at ELORA, a women\\'s fashion brand. Classify the inquiry and draft a warm, concise reply in the brand voice (short, confident, human). Policies: free standard shipping over $100 (3–5 business days, otherwise $8), express $18 (1–2 days), free 30-day returns, ships to CA/UK/EU/AU/JP/SG/MN in 5–10 days. Respond ONLY with JSON: {\"topic\": one of [order, sizing, returns, product, wholesale, press, other], \"urgency\": one of [low, normal, high], \"sentiment\": one of [positive, neutral, negative], \"summary\": string (max 20 words), \"draftReply\": string}.', messages: [{ role: 'user', content: 'Name: ' + $('Verify signature').first().json.inquiry.name + '\\nSubject: ' + $('Verify signature').first().json.inquiry.subject + '\\nOrder: ' + ($('Verify signature').first().json.inquiry.orderNumber || 'n/a') + '\\n\\n' + $('Verify signature').first().json.inquiry.message }] }) }}",
        "options": { "timeout": 30000 }
      },
      "id": "a1f0c6c2-0006-4a7e-9a10-000000000006",
      "name": "AI: classify & draft reply",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [960, 200],
      "credentials": {
        "httpHeaderAuth": { "id": "REPLACE_ME", "name": "Anthropic API (x-api-key)" }
      }
    },
    {
      "parameters": {
        "jsCode": "const inquiry = $('Verify signature').first().json.inquiry;\nconst text = $input.first().json.content?.[0]?.text ?? '{}';\nlet ai;\ntry {\n  ai = JSON.parse(text.replace(/^```json\\s*|```$/g, ''));\n} catch (e) {\n  ai = { topic: 'other', urgency: 'normal', sentiment: 'neutral', summary: inquiry.subject, draftReply: '' };\n}\nreturn [{ json: { ...inquiry, ...ai } }];"
      },
      "id": "a1f0c6c2-0007-4a7e-9a10-000000000007",
      "name": "Parse AI result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1200, 200]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://hooks.slack.com/services/REPLACE/WITH/YOUR-INCOMING-WEBHOOK",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ text: ($json.urgency === 'high' ? ':rotating_light: ' : '') + '*New inquiry* — ' + $json.topic + ' · ' + $json.urgency + ' · ' + $json.sentiment + '\\n*From:* ' + $json.name + ' <' + $json.email + '>\\n*Summary:* ' + $json.summary + '\\n\\n*Suggested reply:*\\n>' + String($json.draftReply).split('\\n').join('\\n>') }) }}",
        "options": {}
      },
      "id": "a1f0c6c2-0008-4a7e-9a10-000000000008",
      "name": "Notify team (Slack)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1440, 200]
    }
  ],
  "connections": {
